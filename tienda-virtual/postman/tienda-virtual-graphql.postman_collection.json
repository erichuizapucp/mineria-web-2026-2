{
  "info": {
    "name": "Tienda Virtual - GraphQL API",
    "description": "GraphQL API de la Tienda Virtual (solo lectura, pensado para scraping).\n\nEndpoint unico: `POST {{baseUrl}}/api/graphql` (GraphiQL disponible abriendo esa URL en el navegador).\n\nAutenticacion: igual que el REST. Por defecto la coleccion usa API key en el header `x-api-key` (`{{apiKey}}`). Para probar con OAuth ejecuta `OAuth / Obtener access token` y usa el request `(via OAuth Bearer)`.\n\nImporta el environment `tienda-virtual.postman_environment.json` y selecciona \"Tienda Virtual - Local\". Arranca el servidor con `npm run dev`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "x-api-key", "type": "string" },
      { "key": "value", "value": "{{apiKey}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "variable": [
    { "key": "productoId", "value": "1" },
    { "key": "clienteId", "value": "1" },
    { "key": "ordenId", "value": "1" },
    { "key": "pageSize", "value": "50" },
    { "key": "pgProductos", "value": "1" },
    { "key": "pgClientes", "value": "1" },
    { "key": "pgOrdenes", "value": "1" },
    { "key": "pgTestimonios", "value": "1" },
    { "key": "productosAll", "value": "[]" },
    { "key": "clientesAll", "value": "[]" },
    { "key": "ordenesAll", "value": "[]" },
    { "key": "testimoniosAll", "value": "[]" }
  ],
  "item": [
    {
      "name": "OAuth",
      "item": [
        {
          "name": "POST Obtener access token (client_credentials)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "client_credentials" },
                { "key": "client_id", "value": "{{oauthClientId}}" },
                { "key": "client_secret", "value": "{{oauthClientSecret}}" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/oauth/token",
              "host": ["{{baseUrl}}"],
              "path": ["api", "oauth", "token"]
            },
            "description": "Guarda `access_token` en `{{accessToken}}` para los requests via Bearer."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('access_token presente', () => pm.expect(json.access_token).to.be.a('string'));",
                  "if (json.access_token) pm.environment.set('accessToken', json.access_token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Queries",
      "item": [
        {
          "name": "Productos con rating agregado",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query Productos($page: Int, $pageSize: Int) {\n  productos(page: $page, pageSize: $pageSize) {\n    items {\n      id\n      codigo\n      nombre\n      precio\n      stock\n      categoria\n      subcategoria\n      aggregateRating { ratingValue reviewCount }\n    }\n    pageInfo { page pageSize total totalPages }\n  }\n}",
                "variables": "{\n  \"page\": 1,\n  \"pageSize\": 10\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["api", "graphql"]
            },
            "description": "Equivale al scraping de `b_productos_sitemap.ipynb`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('sin errors', () => pm.expect(pm.response.json().errors).to.be.undefined);",
                  "pm.test('trae productos', () => pm.expect(pm.response.json().data.productos.items).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Producto por id (especificaciones + resenas)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query Producto($id: Int!) {\n  producto(id: $id) {\n    id\n    nombre\n    descripcion\n    precio\n    stock\n    especificaciones { clave valor orden }\n    aggregateRating { ratingValue reviewCount }\n    resenas { id clienteNombre clienteApellidos calificacion texto fecha }\n  }\n}",
                "variables": "{\n  \"id\": {{productoId}}\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["api", "graphql"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
