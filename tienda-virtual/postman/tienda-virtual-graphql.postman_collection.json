    {
      "name": "Listados completos (auto-paginado)",
      "description": "Recorre TODAS las paginas de cada listado y acumula los resultados en una variable de coleccion (`productosAll`, `clientesAll`, `ordenesAll`, `testimoniosAll`).\n\nEjecuta desde **Collection Runner** o **newman** (el auto-avance con `setNextRequest` no ocurre en un solo Send). Ajusta `pageSize` (variable de coleccion, por defecto 50). Al terminar valida el conteo contra `pageInfo.total` y lo imprime en consola.",
      "item": [
        {
          "name": "Todos los productos",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!Number(pm.collectionVariables.get('pgProductos'))) pm.collectionVariables.set('pgProductos', 1);",
                  "if (Number(pm.collectionVariables.get('pgProductos')) === 1) pm.collectionVariables.set('productosAll', '[]');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('sin errors', () => pm.expect(j.errors).to.be.undefined);",
                  "const d = j.data.productos;",
                  "const acc = JSON.parse(pm.collectionVariables.get('productosAll') || '[]');",
                  "acc.push(...d.items);",
                  "pm.collectionVariables.set('productosAll', JSON.stringify(acc));",
                  "const { page, totalPages, total } = d.pageInfo;",
                  "console.log('productos: pagina ' + page + '/' + totalPages + ' -> acumulados ' + acc.length + '/' + total);",
                  "if (page < totalPages) {",
                  "  pm.collectionVariables.set('pgProductos', page + 1);",
                  "  postman.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "  pm.collectionVariables.set('pgProductos', 1);",
                  "  pm.test('acumulados todos (' + acc.length + ')', () => pm.expect(acc.length).to.eql(total));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query Todos($page: Int, $pageSize: Int) {\n  productos(page: $page, pageSize: $pageSize) {\n    items { id codigo nombre precio stock categoria subcategoria aggregateRating { ratingValue reviewCount } }\n    pageInfo { page pageSize total totalPages }\n  }\n}",
                "variables": "{\n  \"page\": {{pgProductos}},\n  \"pageSize\": {{pageSize}}\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["api", "graphql"]
            }
          }
        },
