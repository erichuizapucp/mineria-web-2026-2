# --- Auth / APIs (REST + GraphQL) ---
# Secreto para firmar JWT (cookie de sesion + access tokens OAuth). Minimo 32 chars.
AUTH_SECRET=dev-insecure-change-me-min-32-characters-long
# Usuario admin sembrado para el login del back-office.
ADMIN_EMAIL=admin@tienda.local
ADMIN_PASSWORD=admin123
# API key demo estable (sobrevive reinicios porque se re-siembra en cada arranque).
DEMO_API_KEY=sk_demo_000000000000000000000000000000
# Cliente OAuth2 demo (grant_type=client_credentials).
DEMO_OAUTH_CLIENT_ID=scraper-demo
DEMO_OAUTH_CLIENT_SECRET=scraper-demo-secret
