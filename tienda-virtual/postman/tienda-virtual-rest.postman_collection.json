          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('trae items y pageInfo', () => {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.items).to.be.an('array');",
                  "  pm.expect(j.pageInfo).to.have.property('totalPages');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET Producto por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/productos/{{productoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "productos", "{{productoId}}"]
            },
            "description": "Detalle + `especificaciones` + `resenas` + `aggregateRating`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "POST Crear producto (scope write)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"PM-{{$timestamp}}\",\n  \"nombre\": \"Producto Postman\",\n  \"descripcion\": \"Creado desde la coleccion de Postman.\",\n  \"categoria\": \"General\",\n  \"subcategoria\": \"Demo\",\n  \"precio\": 199.9,\n  \"stock\": 5\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/productos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "productos"]
            },
            "description": "Crea un producto. Requiere scope `write` (la API key demo y el cliente OAuth demo lo tienen).\nGuarda el id creado en `{{nuevoProductoId}}` para usarlo en PUT/DELETE."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "if (j.id) { pm.collectionVariables.set('nuevoProductoId', j.id); console.log('nuevoProductoId =', j.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT Actualizar producto (scope write)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"precio\": 149.5,\n  \"stock\": 3\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/productos/{{nuevoProductoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "productos", "{{nuevoProductoId}}"]
            },
            "description": "Actualiza campos parciales del producto creado por el request anterior."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "DELETE Eliminar producto (scope write)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/productos/{{nuevoProductoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "productos", "{{nuevoProductoId}}"]
            },
            "description": "Elimina el producto creado en esta corrida."
          },
          "event": [
            {
