                  "const acc = JSON.parse(pm.collectionVariables.get('testimoniosAll') || '[]');",
                  "acc.push(...j.items);",
                  "pm.collectionVariables.set('testimoniosAll', JSON.stringify(acc));",
                  "const { page, totalPages, total } = j.pageInfo;",
                  "console.log('testimonios: pagina ' + page + '/' + totalPages + ' -> acumulados ' + acc.length + '/' + total);",
                  "if (page < totalPages) {",
                  "  pm.collectionVariables.set('pgTestimonios', page + 1);",
                  "  postman.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "  pm.collectionVariables.set('pgTestimonios', 1);",
                  "  pm.test('acumulados todos (' + acc.length + ')', () => pm.expect(acc.length).to.eql(total));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/testimonios?page={{pgTestimonios}}&pageSize={{pageSize}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "testimonios"],
              "query": [
                { "key": "page", "value": "{{pgTestimonios}}" },
                { "key": "pageSize", "value": "{{pageSize}}" }
              ]
            }
          }
        }
      ]
    },
